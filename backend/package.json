{
  "name": "dealership-backend",
  "version": "1.0.0",
  "description": "REST API for the Car Dealership Inventory System",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "npm test -- --coverage",
    "db:migrate": "prisma migrate dev",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "db:seed": "node prisma/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1"
  }
}
